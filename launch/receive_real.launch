<launch>
  <!-- Recibe datos del ABB IRB 120 real (RWS / TCP) o en modo demo y actualiza RViz. -->
  <arg name="mode" default="rws" />             <!-- rws | tcp_client | demo -->
  <arg name="robot_ip" default="192.168.125.1" />
  <arg name="rws_port" default="80" />
  <arg name="tcp_port" default="5000" />
  <arg name="rate" default="15.0" />
  <arg name="log_csv" default="" />
  <arg name="use_rviz" default="true" />
  <arg name="use_official_urdf" default="true" />

  <group if="$(arg use_official_urdf)">
    <include file="$(find abb_irb120_support)/launch/load_irb120_3_58.launch" />
  </group>
  <group unless="$(arg use_official_urdf)">
    <param name="robot_description"
           command="$(find xacro)/xacro '$(find irb120_description)/urdf/irb120.urdf.xacro'" />
  </group>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

  <node name="abb_receive_node" pkg="irb120_description" type="abb_receive_node.py" output="screen">
    <param name="mode" value="$(arg mode)" />
    <param name="robot_ip" value="$(arg robot_ip)" />
    <param name="rws_port" value="$(arg rws_port)" />
    <param name="tcp_port" value="$(arg tcp_port)" />
    <param name="rate" value="$(arg rate)" />
    <param name="log_csv" value="$(arg log_csv)" />
  </node>

  <node if="$(arg use_rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find industrial_robot_client)/config/robot_state_visualize.rviz" required="false" />
</launch>
