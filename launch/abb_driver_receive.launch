<launch>
  <!-- Solo lectura via abb_driver oficial (requiere ROS_stateServer en el controlador ABB, puerto 11002). -->
  <arg name="robot_ip" default="192.168.125.1" />
  <include file="$(find abb_irb120_support)/launch/robot_state_visualize_irb120_3_58.launch">
    <arg name="robot_ip" value="$(arg robot_ip)" />
  </include>
</launch>
